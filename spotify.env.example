# =============================================================================
# Spotify API Credentials für tenor (Beat-Detection)
# =============================================================================
#
# Anleitung zur Erstellung:
# 1. Gehe auf: https://developer.spotify.com/dashboard
# 2. Mit deinem Spotify-Account einloggen.
# 3. Klicke auf "Create app".
#    - App name: tenor
#    - App description: Video beat matching
#    - Redirect URIs: http://localhost (wird nicht zwingend gebraucht, aber Pflichtfeld)
#    - Welche APIs genutzt werden: "Web API" ankreuzen
# 4. Nach dem Erstellen auf "Settings" klicken:
#    - Dort findest du die "Client ID"
#    - Klicke auf "View client secret" für das "Client Secret"
#
# Aktivierung auf diesem Server:
# 1. Kopiere diese Vorlage nach ~/.config/tenor/spotify.env:
#      cp ~/.config/tenor/spotify.env.example ~/.config/tenor/spotify.env
#      chmod 600 ~/.config/tenor/spotify.env
# 2. Trage unten deine echten Schlüssel ein.
# =============================================================================

SPOTIFY_CLIENT_ID=deine_spotify_client_id_hier
SPOTIFY_CLIENT_SECRET=dein_spotify_client_secret_hier
